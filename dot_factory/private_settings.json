{
  "logoAnimation": "off",
  "diffMode": "github",
  "terminalColorMode": "light",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/tao/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ]
  },
  "theme": "factory-light",
  "statusLine": {
    "type": "command",
    "command": "/Users/tao/.factory/statusline.sh"
  },
  "sessionDefaultSettings": {
    "model": "custom:OC:-Company-Opus-4.8",
    "reasoningEffort": "max",
    "interactionMode": "auto",
    "autonomyLevel": "high",
    "autonomyMode": "auto-high",
    "specModeModel": "custom:OC:-Company-GPT-5.5",
    "specModeReasoningEffort": "xhigh"
  },
  "missionModelSettings": {
    "validationWorkerModel": "gpt-5.4",
    "validationWorkerReasoningEffort": "xhigh",
    "skipScrutiny": true,
    "skipUserTesting": false
  },
  "customModels": [
    {
      "model": "claude-opus-4-8",
      "id": "custom:OC:-Company-Opus-4.8",
      "index": 0,
      "baseUrl": "http://localhost:8317/v1",
      "apiKey": "${COMPANY_API_KEY}",
      "displayName": "OC: Company Opus 4.8",
      "maxOutputTokens": 32000,
      "noImageSupport": false,
      "provider": "anthropic"
    },
    {
      "model": "claude-fable-5",
      "id": "custom:OC:-Company-Fable-5",
      "index": 1,
      "baseUrl": "http://localhost:8317/v1",
      "apiKey": "${COMPANY_API_KEY}",
      "displayName": "OC: Company Fable 5",
      "maxOutputTokens": 32000,
      "noImageSupport": false,
      "provider": "anthropic"
    },
    {
      "model": "glm-5.2",
      "id": "custom:OC:-ZAI-Coding-Plan-GLM-5.2",
      "index": 2,
      "baseUrl": "https://api.z.ai/api/anthropic",
      "apiKey": "${ZHIPU_API_KEY}",
      "displayName": "OC: ZAI Coding Plan GLM-5.2",
      "maxOutputTokens": 16384,
      "noImageSupport": false,
      "provider": "anthropic"
    },
    {
      "model": "glm-5.2",
      "id": "custom:OC:-OpenCode-Go-GLM-5.2",
      "index": 3,
      "baseUrl": "https://opencode.ai/zen/go/v1",
      "apiKey": "${OPENCODE_GO_API_KEY}",
      "displayName": "OC: OpenCode Go GLM-5.2",
      "maxOutputTokens": 16384,
      "noImageSupport": false,
      "provider": "openai"
    },
    {
      "model": "k2p7",
      "id": "custom:OC:-Kimi-K2.7",
      "index": 4,
      "baseUrl": "https://api.kimi.com/coding/v1",
      "apiKey": "${KIMI_API_KEY}",
      "displayName": "OC: Kimi K2.7",
      "maxOutputTokens": 16384,
      "noImageSupport": false,
      "provider": "openai"
    },
    {
      "model": "mimo-v2.5-pro",
      "id": "custom:OC:-Xiaomi-MiMo-Pro",
      "index": 5,
      "baseUrl": "https://token-plan-cn.xiaomimimo.com/v1",
      "apiKey": "${XIAOMI_KEY}",
      "displayName": "OC: Xiaomi MiMo Pro",
      "maxOutputTokens": 16384,
      "noImageSupport": false,
      "provider": "openai"
    },
    {
      "model": "MiniMax-M3",
      "id": "custom:OC:-MiniMax-M3",
      "index": 6,
      "baseUrl": "https://api.minimaxi.com/anthropic",
      "apiKey": "${MINIMAX_API_KEY}",
      "displayName": "OC: MiniMax M3",
      "maxOutputTokens": 16384,
      "noImageSupport": false,
      "provider": "anthropic"
    },
    {
      "model": "gpt-5.5",
      "id": "custom:OC:-Company-GPT-5.5",
      "index": 7,
      "baseUrl": "https://token.jinguobyte.com/v1",
      "apiKey": "${JINBUO_API_KEY}",
      "displayName": "OC: Company GPT-5.5",
      "maxOutputTokens": 32000,
      "noImageSupport": false,
      "provider": "openai"
    }
  ],
  "compactionModelMode": "factory-default",
  "showThinkingInMainView": true,
  "showTokenUsageIndicator": true,
  "nerdFont": true,
  "overrideTerminalColors": false,
  "windowZoomLevel": 0,
  "remoteAccessEnabled": true,
  "reauthBannerShownTui": true,
  "enabledPlugins": {
    "droid-control@factory-plugins": true,
    "core@factory-plugins": true
  },
  "modelFavorites": [
    "gpt-5.5",
    "kimi-k2.7-code",
    "glm-5.2"
  ]
}
