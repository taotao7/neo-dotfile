{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "description": "Default coding agent for implementation, edits, refactors, and iterative fixes.",
      "mode": "primary",
      "model": "company/claude-opus-4-8"
    },
    "compaction": {
      "model": "zai-coding-plan/glm-5.2",
      "variant": "max"
    },
    "explore": {
      "description": "Fast codebase exploration, file discovery, dependency tracing, and context gathering.",
      "mode": "subagent",
      "model": "zai-coding-plan/glm-5.2",
      "variant": "max"
    },
    "general": {
      "description": "General-purpose fallback agent for multi-step tasks that don't fit a specialist: research, cross-cutting searches, and mixed read/edit chores.",
      "mode": "all",
      "model": "kimi-for-coding/k2p7"
    },
    "plan": {
      "description": "Plan mode for architecture, task decomposition, migrations, and risk analysis before edits.",
      "mode": "primary",
      "model": "zai-coding-plan/glm-5.2",
      "permission": {
        "bash": "ask",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "read": "allow"
      },
      "variant": "max"
    },
    "summary": {
      "model": "opencode-go/glm-5.2",
      "variant": "max"
    },
    "title": {
      "model": "zai-coding-plan/glm-5.2",
      "variant": "max"
    }
  },
  "default_agent": "build",
  "mcp": {
    "codebase-memory-mcp": {
      "command": ["/Users/tao/.local/bin/codebase-memory-mcp"],
      "enabled": true,
      "type": "local"
    },
    "web-reader": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:ZHIPU_API_KEY}"
      },
      "timeout": 30000,
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp"
    },
    "web-search-prime": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:ZHIPU_API_KEY}"
      },
      "timeout": 30000,
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp"
    },
    "zai-vision": {
      "command": ["npx", "-y", "@z_ai/mcp-server@latest"],
      "enabled": true,
      "environment": {
        "Z_AI_API_KEY": "{env:ZHIPU_API_KEY}",
        "Z_AI_MODE": "ZAI"
      },
      "timeout": 30000,
      "type": "local"
    },
    "zread": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:ZHIPU_API_KEY}"
      },
      "timeout": 30000,
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp"
    }
  },
  "model": "company/claude-opus-4-8",
  "permission": "allow",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "provider": {
    "company": {
      "models": {
        "claude-opus-4-8": {
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "name": "Claude Opus 4.8",
          "reasoning": true,
          "tool_call": true
        },
        "claude-fable-5": {
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "name": "Claude Fable 5",
          "reasoning": true,
          "tool_call": true
        }
      },
      "name": "Company Opus",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "sk-0l3IJWCxwYrfRoG0G",
        "baseURL": "http://localhost:8317/v1"
      }
    }
  },
  "small_model": "zai-coding-plan/glm-5.2"
}
