font-family = "Iosevka Mono"
font-size = 14
# theme=dark: "catppuccin-frappe",light: "catppuccin-latte"
# theme = dark:analog-dream-magnetic-night,light:analog-dream-beige-terminal
theme = dark:cassette-futurism-dark,light:cassette-futurism-light
background-opacity = 0.92
background-blur-radius = 20
window-height=60
window-width=100
window-padding-x = 8
window-padding-y = 4
keybind = shift+enter=text:\n
command = /bin/sh -c "/opt/homebrew/bin/tmux attach || /opt/homebrew/bin/tmux new"

cursor-style = bar
cursor-style-blink = false
custom-shader = ~/.config/ghostty/shaders/sonic_boom_cursor.glsl
window-decoration = none

