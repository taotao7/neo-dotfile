{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "model": "company-opus/claude-opus-4-8",
  "small_model": "zai-coding-plan/glm-5.2",
  "default_agent": "build",
  "permission": "allow",
  "provider": {
    "company-opus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Company Opus",
      "options": {
        "baseURL": "http://localhost:8317/v1",
        "apiKey": "sk-0l3IJWCxwYrfRoG0G"
      },
      "models": {
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "description": "Default coding agent for implementation, edits, refactors, and iterative fixes.",
      "mode": "primary",
      "model": "company-opus/claude-opus-4-8"
    },
    "plan": {
      "description": "Plan mode for architecture, task decomposition, migrations, and risk analysis before edits.",
      "mode": "primary",
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "ask"
      }
    },
    "explore": {
      "description": "Fast codebase exploration, file discovery, dependency tracing, and context gathering.",
      "mode": "subagent",
      "model": "zai-coding-plan/glm-5.2",
      "variant": "max"
    },
    "general": {
      "description": "Miscellaneous helper agent for small chores, routine edits, formatting, and low-risk follow-up tasks.",
      "mode": "all",
      "model": "kimi-for-coding/k2p7"
    },
    "title": {
      "model": "zai-coding-plan/glm-5.2",
      "variant": "max"
    },
    "summary": {
      "model": "opencode-go/glm-5.2",
      "variant": "max"
    },
    "compaction": {
      "model": "zai-coding-plan/glm-5.2",
      "variant": "max"
    }
  },
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": ["/Users/tao/.local/bin/codebase-memory-mcp"],
      "enabled": true
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "enabled": true,
      "timeout": 30000,
      "headers": {
        "Authorization": "Bearer {env:ZHIPU_API_KEY}"
      }
    },
    "web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "enabled": true,
      "timeout": 30000,
      "headers": {
        "Authorization": "Bearer {env:ZHIPU_API_KEY}"
      }
    },
    "zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "enabled": true,
      "timeout": 30000,
      "headers": {
        "Authorization": "Bearer {env:ZHIPU_API_KEY}"
      }
    },
    "zai-vision": {
      "type": "local",
      "command": ["npx", "-y", "@z_ai/mcp-server@latest"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "Z_AI_API_KEY": "{env:ZHIPU_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    }
  }
}
